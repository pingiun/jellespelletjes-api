[Unit]
Description=jellespelletjes API (accounts and score sync for woordle.nl and sudokudo.nl)
After=network-online.target
Wants=network-online.target

[Service]
User=jsp
Group=jsp
ExecStart=/usr/local/bin/jellespelletjes-api serve
EnvironmentFile=/etc/jellespelletjes-api.env
WorkingDirectory=/var/lib/jellespelletjes-api
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jellespelletjes-api
PrivateTmp=true

[Install]
WantedBy=multi-user.target
